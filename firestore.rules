rules_version = '2';
// Kangaroo Bingo.
//   players/{uid}  one PRIVATE card per anonymous player: only its owner and judges can read it,
//                  so nobody can copy the crowd's answers (the judge's cross-check relies on that).
//   board/{uid}    the PUBLIC leaderboard row for that card. Written in the same batch as the card;
//                  rules check it matches the card exactly (getAfter), so it can't be faked.
//   judges/{uid}   created by entering the judge code; the code lives in secret/judge, which no
//                  client can read: rules compare against it server-side.
//   config/game    { open: bool }: judges open/close claims.
// BINGO = 1+ completed lines (across, down or diagonal); more lines outrank fewer. The claim time is the server's: a claim must write
// claimedAt == request.time, and only a judge can approve/reject, without touching claimedAt.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isJudge() {
      return signedIn() && exists(/databases/$(db)/documents/judges/$(request.auth.uid));
    }
    function gameOpen() {
      let g = /databases/$(db)/documents/config/game;
      return !exists(g) || get(g).data.open == true;
    }
    function validPlayer(d) {
      return d.keys().hasOnly(['name','syn','layout','marks','filled','lines','status','claimedAt',
                               'note','judgedAt','judgedBy','createdAt','updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.syn is string && d.syn.size() <= 20
        && d.layout is list && d.layout.size() == 24
        && d.marks is map && d.marks.size() <= 24
        && d.filled is int && d.filled == d.marks.size()
        && d.lines is int;
    }
    // Square at layout position k has a name on it.
    function on(d, k) { return string(d.layout[k]) in d.marks; }
    // Completed lines on a card: 5 rows, 5 columns, 2 diagonals (the free centre counts).
    // The server counts them itself, so a card can never claim more lines than it has.
    function lineCount(d) {
      return [
        (on(d, 0) && on(d, 1) && on(d, 2) && on(d, 3) && on(d, 4)),
        (on(d, 5) && on(d, 6) && on(d, 7) && on(d, 8) && on(d, 9)),
        (on(d, 10) && on(d, 11) && on(d, 12) && on(d, 13)),
        (on(d, 14) && on(d, 15) && on(d, 16) && on(d, 17) && on(d, 18)),
        (on(d, 19) && on(d, 20) && on(d, 21) && on(d, 22) && on(d, 23)),
        (on(d, 0) && on(d, 5) && on(d, 10) && on(d, 14) && on(d, 19)),
        (on(d, 1) && on(d, 6) && on(d, 11) && on(d, 15) && on(d, 20)),
        (on(d, 2) && on(d, 7) && on(d, 16) && on(d, 21)),
        (on(d, 3) && on(d, 8) && on(d, 12) && on(d, 17) && on(d, 22)),
        (on(d, 4) && on(d, 9) && on(d, 13) && on(d, 18) && on(d, 23)),
        (on(d, 0) && on(d, 6) && on(d, 17) && on(d, 23)),
        (on(d, 4) && on(d, 8) && on(d, 15) && on(d, 19))
      ].removeAll([false]).size();
    }
    function ownerStatusOk(d) {
      return (d.status == 'playing' && d.claimedAt == null)
        // Claiming: the server counts the lines itself (once: rules have a per-request budget), so the
        // line count that ranks the claim is always real. A claimed card is locked, so it stays real.
        || (d.status == 'claimed' && d.claimedAt == request.time && gameOpen()
            && d.lines >= 1 && d.lines == lineCount(d));
    }
    // The public row must equal the card as it stands after this write.
    function mirrors(uid) {
      let p = getAfter(/databases/$(db)/documents/players/$(uid)).data;
      let r = request.resource.data;
      return r.keys().hasOnly(['name','syn','filled','lines','status','claimedAt','accused'])
        && r.name == p.name && r.syn == p.syn && r.filled == p.filled && r.lines == p.lines
        && r.status == p.status && r.claimedAt == p.claimedAt
        && r.accused is list && r.accused.size() <= 24;
    }

    match /config/game {
      allow read: if true;
      allow write: if isJudge();
    }

    match /secret/{d=**} {
      allow read, write: if false;
    }

    match /judges/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'at'])
        && request.resource.data.code == get(/databases/$(db)/documents/secret/judge).data.code;
    }

    match /board/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || isJudge()) && mirrors(uid);
      allow delete: if isJudge();
    }

    match /players/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isJudge());

      allow create: if signedIn() && request.auth.uid == uid
        && validPlayer(request.resource.data)
        && request.resource.data.status == 'playing'
        && request.resource.data.claimedAt == null;

      // Owner: can only move the card to playing or claimed. A card under review or approved is
      // locked unless the owner withdraws it (back to playing, claim time cleared) to go for more lines.
      allow update: if signedIn() && request.auth.uid == uid
        && (resource.data.status in ['playing', 'rejected'] || request.resource.data.status == 'playing')
        && validPlayer(request.resource.data)
        && ownerStatusOk(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['layout', 'createdAt', 'note', 'judgedAt', 'judgedBy']);

      // Judge: verdict fields only. claimedAt is untouchable, so the submit time stands.
      allow update: if isJudge()
        && resource.data.status in ['claimed', 'approved', 'rejected']
        && request.resource.data.status in ['claimed', 'approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'note', 'judgedAt', 'judgedBy'])
        && request.resource.data.judgedAt == request.time
        && request.resource.data.judgedBy == request.auth.uid;

      allow delete: if isJudge();
    }
  }
}
